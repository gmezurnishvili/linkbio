# Backend (Hono) origin. Server-side calls go direct; the browser talks to
# /api/proxy so the access token never has to be readable by JS on a domain
# that also serves creator-authored content.
API_ORIGIN=http://localhost:8787
NEXT_PUBLIC_API_BASE=/api/proxy

# Public profile origin, used for canonical URLs and JSON-LD @id.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Click beacon endpoint. The API serves this at /v1/events; it used to say
# /v1/beacon, a path that has never existed, so every beacon 404ed. Points at the
# backend directly (not the proxy) so a
# redirect never waits on the Next Lambda.
NEXT_PUBLIC_BEACON_URL=http://localhost:8787/v1/events

# Cap on the s-maxage we will honour from the rule evaluator, in seconds.
# The evaluator returns the exact next decision boundary; this only guards
# against a profile with no time rules pinning a variant forever.
#
# Read at request time, so the deployed stack sets it as a Lambda environment
# variable. It must not exceed the CloudFront cache policy's maxTtl (24h) or the
# CDN silently truncates every TTL the evaluator computes.
MAX_S_MAXAGE=3600

# --- deployment only ---
#
# Set to `sigv4` to sign server-side calls to API_ORIGIN with the Lambda
# execution role's credentials. The deployed API is a Lambda function URL with
# AWS_IAM auth, so that nothing can reach the control plane without passing the
# WAF in front of CloudFront; this app calls it directly rather than looping back
# through the CDN, so it signs for itself. Unset everywhere else — locally the
# API is a plain HTTP server with no IAM in front of it.
# API_AUTH_MODE=sigv4
#
# NOTE on NEXT_PUBLIC_* values above: Next inlines them as literals at build
# time, in server code as well as client code, so a Lambda environment variable
# cannot change one after the fact. `npm run build:lambda` sets them explicitly
# for exactly that reason — see web/scripts/package-lambda.mjs. In the deployed
# single-origin topology they are all relative paths, so nothing needs a
# hostname baked in except NEXT_PUBLIC_SITE_ORIGIN, which is passed to the build
# as SITE_ORIGIN and may be left empty until there is a domain.
