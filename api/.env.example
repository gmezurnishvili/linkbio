# Copy to .env — `npm run dev` and `npm start` load it automatically.
#
# Configuration is parsed and validated at startup (src/env.ts). A bad value
# stops the process with a message naming the key, rather than turning into NaN
# and silently disabling whatever it configured.

# In-memory repository. Swap to `dynamo` only with a real table.
DB_DRIVER=memory

# Signs and verifies the tokens this API issues. At least 32 bytes.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=local-development-secret-at-least-32-bytes

PORT=8787
NODE_ENV=development

# Browser origins allowed to call this API cross-origin. The dashboard talks to
# it through its own server-side proxy, so it is same-origin and needs nothing
# here; only the click beacon is a genuine cross-origin caller, and it is a
# simple request that never preflights.
CORS_ORIGINS=http://localhost:3000

# --- production only ---
# With an external issuer (Cognito, Auth0, Clerk), set these instead of
# AUTH_SECRET. JWT_AUDIENCE is required: without it, every token that issuer has
# ever minted is accepted, including ones for other apps in the same pool.
# JWKS_URL=
# JWT_ISSUER=
# JWT_AUDIENCE=

# Set when deploying against a real table and edge store.
# TABLE_NAME=linkbio
# KVS_ARN=

# Limits. Each is validated as an integer in range.
# MAX_BLOCKS=200
# MAX_RULES=20
# EVENTS_PER_MINUTE=120
# ACCESS_TTL_SECONDS=900
# REFRESH_TTL_SECONDS=2592000

# --- feeds ---
# Feed blocks are filled by a scheduled refresher, not on the render path. Two
# of the five sources have no anonymous read path; leaving their credentials
# unset makes those blocks report "unconfigured" at refresh time rather than
# failing to boot, so a deployment with no Spotify blocks needs no Spotify app.
#
# youtube and rss need nothing at all — YouTube publishes an Atom feed per
# channel with no key and no quota.
#
# github works unauthenticated at 60 requests an hour per IP, shared across
# every block in the fleet. A token raises that to 5,000.
# GITHUB_TOKEN=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# FEED_MAX_ITEMS=8
# FEED_TIMEOUT_MS=8000
# FEED_MAX_BYTES=1000000
# FEED_BATCH=25
# FEED_CONCURRENCY=4

# --- edge ---
# The edge answers rule-free links straight out of the KeyValueStore without
# reaching the origin. Those clicks are therefore never counted server-side —
# the page's own beacon still fires, but a visitor with JavaScript off is
# invisible. Set to `off` to keep every redirect on the origin path.
#
# This only does anything once `/r/*` is a CloudFront behaviour on the API
# origin, which it now is: the distribution serves the web app by default and
# routes /r/*, /p/*, /v1/* and /health to the API, so a click never wakes the
# Next Lambda. Locally, and in any single-origin deployment, the Next route
# handler at web/src/app/r/[handle]/[blockId]/route.ts answers instead and no
# hot link is consulted.
# HOT_LINKS=on
